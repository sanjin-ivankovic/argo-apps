# ==============================================================================
# GitOps ArgoCD Repository - .gitignore
# ==============================================================================
# Manages Kubernetes manifests using the app-of-apps pattern with Kustomize
# and Helm. SealedSecrets are committed (encrypted); plaintext secrets are not.
# ==============================================================================

# ==============================================================================
# OS - macOS
# ==============================================================================

.DS_Store
.DS_Store?
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
.VolumeIcon.icns
.TemporaryItems
.fseventsd

# ==============================================================================
# IDE & Editors
# ==============================================================================

# VSCode (keep project-level settings)
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# ==============================================================================
# Secret Management
# ==============================================================================
# IMPORTANT: SealedSecret YAML files (cluster/*/secrets/*-sealed-secret.yaml)
# MUST be committed — they are encrypted and safe to store in Git.

# Environment files
.env
.env.*
*.env.local
*.env.*.local
!.env.example

# Plaintext secret files
secrets.yaml
secrets.yml
unencrypted-secrets/
*.secret

# Certificate and key files
*.key
*.pem
*.crt
!*.crt.yaml
*.p12
*.pfx
*.cer
*.der
*.csr

# SSH keys
*_rsa
*_ed25519
*_ecdsa
*_dsa
id_*
!id_*.example

# ACME certificates
acme.json

# ==============================================================================
# Kubernetes & Kustomize
# ==============================================================================

# Kustomize build artifacts
.kustomize-builds/

# Helm chart downloads (charts are referenced by URL, not vendored)
**/charts/
# Exception: postgresql's chart is vendored. Its OCI source is Harbor, which
# runs INSIDE the cluster and depends on this very database (wave 5 vs 4) —
# pulling at render time would deadlock cold bootstrap and any window where
# Harbor is down. Keep the committed copy in lockstep with the version pin.
!apps/data/postgresql/charts/
!apps/data/valkey/charts/

# Kubeconfig files — never commit cluster access credentials
kubeconfig
*.kubeconfig
*-kubeconfig.yaml
config.kubectl

# Local test and render output
test-local/
local-test/
*.local.yaml
*.local.yml
rendered/
output/
dist/

# ==============================================================================
# Go — Kryptos Secret Management Tool
# ==============================================================================
# Python — CI/CD Scripts
# ==============================================================================

# Virtual environments
.venv/
venv/

# Python cache
__pycache__/
*.pyc

# Pytest cache + coverage artifacts
.pytest_cache/
.coverage
coverage.xml
htmlcov/

# ==============================================================================
# CI/CD Artifacts (pipeline reports + local run artifacts kept ignored)
# ==============================================================================

# Security and quality report artifacts
gl-code-quality-report.json
gl-secret-detection-report.json
security-findings.json
*.sarif

# Dynamically generated child pipeline
child-pipeline.yml

# ==============================================================================
# Temp & Backup Files
# ==============================================================================

*.tmp
*.temp
*.log
*.log.*
logs/
*.bak
*.backup
*.old
*.orig

# ==============================================================================
# Project-Specific
# ==============================================================================

# Sanitizer run reports
.ci/sanitize/reports/

# Certificate/secret backups (contains private keys)
.backups/

# Local caches
.cache/
.renovate-cache/

# Continue MCP Servers (contains API keys)
.continue/
